{
  "name": "lookthrough",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fork": "bash scripts/fork.sh",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:anchor": "bash scripts/anchor-test.sh",
    "test:e2e": "vitest run --project e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:anchor && pnpm smoke",
    "probe": "tsx scripts/probe.ts",
    "fixtures:capture": "tsx scripts/fixtures-capture.ts",
    "visibility": "tsx scripts/visibility-stat.ts",
    "merkle:vectors": "tsx scripts/merkle-vectors.ts",
    "registrar": "tsx scripts/run-snapshot.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "demo": "tsx scripts/demo.ts",
    "idl:sync": "bash scripts/idl-sync.sh",
    "anchor:build": "anchor build --arch v0 && bash scripts/idl-sync.sh",
    "anchor:deploy": "bash scripts/anchor-deploy.sh",
    "smoke": "bash scripts/smoke.sh",
    "seed:devnet": "LOOKTHROUGH_ENV=devnet tsx scripts/seed-devnet.ts",
    "dev:devnet": "LOOKTHROUGH_ENV=devnet pnpm --filter @lookthrough/web exec next dev -p 3001",
    "registrar:devnet": "LOOKTHROUGH_ENV=devnet tsx scripts/run-snapshot.ts"
  },
  "devDependencies": {
    "@anchor-lang/core": "1.2.0",
    "@eslint/js": "^9.39.0",
    "@kamino-finance/klend-sdk": "12.0.0",
    "@lookthrough/adapters": "workspace:*",
    "@lookthrough/core": "workspace:*",
    "@lookthrough/datasources": "workspace:*",
    "@lookthrough/registrar": "workspace:*",
    "@lookthrough/resolver": "workspace:*",
    "@lookthrough/sdk": "workspace:*",
    "@noble/hashes": "2.4.0",
    "@raydium-io/raydium-sdk-v2": "0.2.69-alpha",
    "@solana-program/address-lookup-table": "0.8.0",
    "@solana/kit": "2.3.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.19.0",
    "bn.js": "5.2.1",
    "decimal.js": "10.6.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.0.0"
  },
  "type": "module"
}
