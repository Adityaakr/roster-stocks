# Read-only mainnet RPC for fixtures and the visibility stat. Keyed providers rate-limit getProgramAccounts by
# compute units; the public endpoint is used as a fallback for those calls.
MAINNET_RPC_URL=
# The surfpool fork every write goes to (pnpm fork).
FORK_RPC_URL=http://127.0.0.1:8899
# Optional datasource for the fork itself (defaults to public mainnet).
FORK_DATASOURCE_URL=
# tokens.xyz Assets API key, server-side only. Without it the issuer console falls back to the default mint.
TOKENS_API_KEY=
# Optional, only for the stretch Backpack signed rail (not wired in v1).
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
# Local file, never committed. pnpm fork creates it.
REGISTRAR_KEYPAIR_PATH=.keys/registrar.json
# Demo mode: demo wallets, server-signed actions, issuer console enabled.
DEMO_MODE=1
NEXT_PUBLIC_DEMO_MODE=1
# AAPLx (Apple xStock), verified against mainnet.
NEXT_PUBLIC_DEFAULT_MINT=XsbEhLAtcf6HdfpFZ5xEMdqW8nfAvcsP5bdudRLJzJp
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
